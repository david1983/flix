# Flix — copy to .env and adjust.

# Folder with your video files (movies + TV episodes)
MEDIA_DIR=/mnt/nfs/movies

# Server
PORT=8787
HOST=0.0.0.0

# IMDb metadata lookups (set to 0 to disable)
IMDB=1

# Library rescan interval in minutes
RESCAN_MINUTES=15

# Transmission JSON-RPC (torrent downloads). Only exposed inside the compose network.
TRANSMISSION_RPC_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_USER=transmission
TRANSMISSION_PASSWORD=

# Subtitles via OpenSubtitles (https://www.opensubtitles.org — API section, free key).
# Search works with OS_API_KEY alone; downloading files also needs OS_LOGIN/OS_PASSWORD.
OS_API_KEY=
OS_LOGIN=
OS_PASSWORD=